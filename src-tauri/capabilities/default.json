{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Core permissions for the Glyph main + prompt windows.",
  "windows": ["main", "prompt"],
  "permissions": [
    "core:default",
    "opener:default",
    "shell:allow-execute",
    {
      "identifier": "shell:allow-spawn",
      "allow": [{ "name": "binaries/audiocap", "sidecar": true, "args": true }]
    }
  ]
}
