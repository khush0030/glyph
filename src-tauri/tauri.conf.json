{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Glyph",
  "version": "0.1.0",
  "identifier": "ai.oltaflock.glyph",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Glyph",
        "width": 1180,
        "height": 780,
        "minWidth": 940,
        "minHeight": 640,
        "resizable": true,
        "titleBarStyle": "Transparent"
      },
      {
        "label": "prompt",
        "title": "Glyph",
        "url": "index.html",
        "width": 360,
        "height": 168,
        "visible": false,
        "focus": false,
        "alwaysOnTop": true,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "skipTaskbar": true,
        "visibleOnAllWorkspaces": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "app",
    "category": "Productivity",
    "icon": ["icons/icon.icns"],
    "macOS": {
      "minimumSystemVersion": "14.4",
      "entitlements": "Entitlements.plist",
      "signingIdentity": "-"
    },
    "externalBin": ["binaries/audiocap"]
  }
}
